rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'saurav586kumar@gmail.com' ||
          request.auth.token.email == 'Saurav586kumar@gmail.com' ||
          request.auth.token.email.matches('(?i)^saurav586kumar@gmail[.]com$') ||
          request.auth.token.email == 'educhampps@gmail.com' ||
          request.auth.token.email.matches('(?i)^educhampps@gmail[.]com$')
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins document
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'saurav586kumar@gmail.com' ||
          request.auth.token.email == 'Saurav586kumar@gmail.com' ||
          request.auth.token.email.matches('(?i)^saurav586kumar@gmail[.]com$') ||
          request.auth.token.email == 'educhampps@gmail.com' ||
          request.auth.token.email.matches('(?i)^educhampps@gmail[.]com$')
        )) ||
        isAdmin()
      );
    }

    // Public catalog: products, categories, banners, store settings
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'rating', 'ratingCount'])
      );
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /storeSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // Nested addresses
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Cart and Wishlist
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isAdmin();
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isAdmin();
      allow delete: if isAdmin();
    }

    // Product reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Health & connection testing
    match /test/{docId} {
      allow read: if true;
    }

    // Customer support messages & conversations
    match /supportMessages/{messageId} {
      allow read: if (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerUid == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      )) || isAdmin();
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.customerUid == request.auth.uid ||
        request.resource.data.senderId == request.auth.uid ||
        isAdmin()
      );
      allow update: if (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customerUid == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    match /supportConversations/{convId} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isAdmin();
      allow create, update: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Chats collection & subcollections
    match /chats/{chatId} {
      allow read: if (isSignedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        isAdmin()
      )) || isAdmin();
      allow create, update: if isSignedIn() && (
        request.resource.data.customerUid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if (isSignedIn() && (
          resource.data.customerUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.senderId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid ||
          isAdmin()
        )) || isAdmin();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // In-app notifications
    match /notifications/{notificationId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Out-of-stock Restock Notifications Subscriptions
    match /restockSubscriptions/{subId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Vouchers (Public can read active to validate codes, write admin only)
    match /vouchers/{voucherId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Wallet Ledger
    match /walletLedger/{ledgerId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
